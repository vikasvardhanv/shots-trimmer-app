# Environment Variables Example
# Copy this file to .env and set your own values

# Flask Environment
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-generate-a-random-one

# API Configuration
API_KEY=your-api-key-here-generate-a-random-one

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Application Settings
MAX_CONTENT_LENGTH=104857600  # 100MB in bytes
DEBUG=False

# Database Configuration
DATABASE_URL=sqlite:///app.db

# OAuth Configuration
# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=157963579583-dud4n2ur9g5479fc4r8vbg9ou2n5onlv.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-placeholder_client_secret_replace_with_real_value

# GitHub OAuth (Get from GitHub Developer Settings)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Optional: Add your own custom settings here